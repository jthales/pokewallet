# Porta HTTP do backend
PORT=3000
# PostgreSQL. Localmente: `docker compose up -d` na raiz do projeto sobe um banco com estes dados.
# No Vercel + Neon, estas duas variáveis são criadas automaticamente pela integração.
DATABASE_URL="postgresql://pokewallet:pokewallet@localhost:5432/pokewallet"
DATABASE_URL_UNPOOLED="postgresql://pokewallet:pokewallet@localhost:5432/pokewallet"
# Banco usado pelos testes automatizados (é apagado e recriado a cada execução)
TEST_DATABASE_URL="postgresql://pokewallet:pokewallet@localhost:5432/pokewallet_test"
# API pública da TCGdex (sem API key)
TCGDEX_BASE_URL="https://api.tcgdex.net/v2"
# Tempo de cache das consultas ao catálogo, em segundos
CATALOG_CACHE_TTL_SECONDS=21600
# Tempo máximo de cada requisição à TCGdex, em milissegundos
CATALOG_TIMEOUT_MS=8000
# Origens liberadas no CORS (separadas por vírgula). Em dev o Angular usa proxy, então não é necessário.
CORS_ORIGIN="http://localhost:4200"
