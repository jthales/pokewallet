# Porta HTTP do backend
PORT=3000
# Banco SQLite (caminho relativo à pasta prisma/)
DATABASE_URL="file:./dev.db"
# API pública da TCGdex (sem API key)
TCGDEX_BASE_URL="https://api.tcgdex.net/v2"
# Tempo de cache das consultas ao catálogo, em segundos
CATALOG_CACHE_TTL_SECONDS=21600
# Tempo máximo de cada requisição à TCGdex, em milissegundos
CATALOG_TIMEOUT_MS=8000
# Origens liberadas no CORS (separadas por vírgula). Em dev o Angular usa proxy, então não é necessário.
CORS_ORIGIN="http://localhost:4200"
